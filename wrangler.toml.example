name = "fullstack-worker"
main = "worker-api/build/worker/shim.mjs"
compatibility_date = "2024-01-01"

[build]
command = "cargo install -q worker-build && cd worker-api && worker-build --release"
cwd = "."

[[d1_databases]]
binding = "DB"
database_name = "items-db"
database_id = "<YOUR_D1_DATABASE_ID>"
migrations_dir = "migrations"

[[kv_namespaces]]
binding = "RATE_LIMIT"
id = "<YOUR_KV_NAMESPACE_ID>"

[site]
bucket = "./worker-ui/dist"
